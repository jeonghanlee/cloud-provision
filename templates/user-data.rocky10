#cloud-config

ssh_pwauth: false

users:
  - name: vmadmin
    gecos: System Administrator
    groups: [wheel]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    ssh_authorized_keys:
      - SSH_AUTHORIZED_KEY_PLACEHOLDER

write_files:
  - path: /etc/sudoers.d/91-cloud-provision-validation
    owner: root:root
    permissions: '0440'
    content: |
      Defaults:vmadmin verifypw=any

packages:
  - git
  - vim
  - tmux
  - net-tools
  - autoconf
  - automake
  - gcc
  - make
  - openssl-devel

timezone: America/Los_Angeles

final_message: "Rocky Linux 10 ready after $UPTIME seconds"
