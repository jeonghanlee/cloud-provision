IMAGE_DIR       := $(HOME)/libvirt/images
LIBVIRT_URI     := qemu:///system
LIBVIRT_NETWORK := lab
REQUIRED_GROUP  := libvirt
ANSIBLE_DIR     := $(TOP)/../ansible-provision

VM_PREFIX := lab
OS_TYPES  := rocky8 debian12 debian13 rocky10 ubuntu24 ubuntu26 rocky8-iocrunner debian13-iocrunner rocky8-iocrunner-nfs debian13-iocrunner-nfs debian13-ethercat debian13-rtbase rocky8-epics-dev debian12-epics-dev debian13-epics-dev rocky10-epics-dev ubuntu24-epics-dev ubuntu26-epics-dev rocky8-archiver-dev debian13-archiver-dev
NODE_IDS  := main

# Subset of OS_TYPES that `make all`, `make status`, and `make stop` act on:
# the plain base test VMs. Every other selector is driven through its own
# target, and a pre-baked variant additionally cannot be provisioned until
# its golden image exists.
DEFAULT_OS_TYPES := rocky8 debian13

# Base OS types that the iocrunner bake script accepts.
BAKE_OS_TYPES := rocky8 debian13

# Base OS types that the ethercat bake script accepts. EtherCAT is Debian 13
# only, so the ethercat golden image is baked from the debian13 base alone.
ETHERCAT_BAKE_OS_TYPES := debian13

# EPICS-env from-source build hosts. Inventory and playbook are relative
# to ANSIBLE_DIR.
EPICS_ENV_RAM       := 4096
EPICS_ENV_INVENTORY := inventory/lab.ini
EPICS_ENV_PLAYBOOK  := playbooks/species/epics_dev.yml

-include $(TOP)/../CONFIG_SITE.local
-include $(TOP)/configure/CONFIG_SITE.local
